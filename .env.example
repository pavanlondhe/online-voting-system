# MahaVote - Environment Configuration Example
# EDUCATIONAL DEMONSTRATION PLATFORM - NOT AN OFFICIAL ELECTION SERVICE

PORT=5000
NODE_ENV=development

# Database Options:
# SQLite (default for instant zero-dependency local dev):
DATABASE_URL="file:./dev.db"

# PostgreSQL (for Docker or production deployment):
# DATABASE_URL="postgresql://mahavote_user:mahavote_secure_pass@localhost:5432/mahavote_db?schema=public"

JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters_long"
JWT_REFRESH_SECRET="replace_with_another_secure_random_string_for_refresh"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
